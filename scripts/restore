#!/bin/bash
source /usr/share/yunohost/helpers

ynh_script_progression "Restoring Freenet compose config and systemd unit..."
ynh_restore "$install_dir/docker-compose.yml"
ynh_safe_rm "/etc/systemd/system/$app.service"
ynh_restore "/etc/systemd/system/$app.service"

if [ -f "$BACKUP_DIR/${app}-data.tar.gz" ]; then
    ynh_script_progression "Restoring node identity/data into volume ${app}-data..."
    docker volume create "${app}-data" >/dev/null 2>&1 || true
    docker run --rm -v "${app}-data:/data" -v "$BACKUP_DIR:/backup:ro" alpine:latest \
        sh -c "rm -rf /data/* /data/.[!.]* 2>/dev/null; tar -xzf /backup/${app}-data.tar.gz -C /data"
    ynh_app_setting_set --key=skip_orphan_backup_alert --value=1
fi

ynh_script_progression "Restarting Freenet node..."
systemctl daemon-reload
systemctl restart "$app" || docker compose -f "$install_dir/docker-compose.yml" up -d

# Re-render the custom nginx snippet (not part of the backup archive; on a
# fresh machine the vhost dir may not even exist yet).
domain=$(ynh_app_setting_get --key=domain || echo "")
if [ -n "${domain:-}" ] && [ -d "/etc/nginx/conf.d/$domain.d" ]; then
    ynh_config_add_nginx
fi
