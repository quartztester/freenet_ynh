#!/bin/bash
source /usr/share/yunohost/helpers

ynh_abort_if_errors

ynh_script_progression "Re-rendering compose config and systemd unit..."
ynh_safe_rm "$install_dir/docker-compose.yml"
ynh_config_add --template="docker-compose.yml" --destination="$install_dir/docker-compose.yml"
ynh_safe_rm "/etc/systemd/system/$app.service"
ynh_config_add_systemd

ynh_script_progression "Re-rendering nginx config and refreshing logo..."
domain=$(ynh_app_setting_get --key=domain || echo "")
if [ -n "${domain:-}" ]; then
    ynh_safe_rm "/etc/nginx/conf.d/$domain.d/$app.conf"
    ynh_config_add_nginx
fi
if [ -f "$YNH_APP_BASEDIR/conf/freenet.png" ]; then
    cp "$YNH_APP_BASEDIR/conf/freenet.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

# The node self-updates in-place over the network; this pull only refreshes the
# base image so a fresh container starts current instead of updating on boot.
ynh_script_progression "Pulling newer image and recreating container (node data volume is preserved)..."
docker compose -f "$install_dir/docker-compose.yml" pull || ynh_print_warn "Image pull failed (offline?) — continuing with existing image."
systemctl daemon-reload
systemctl restart "$app"

ynh_script_progression "Waiting for the node dashboard..."
waited=0
while [ "$waited" -lt 300 ]; do
    if curl -fsS -m 3 "http://127.0.0.1:$port/v1/version" >/dev/null 2>&1; then
        break
    fi
    sleep 5
    waited=$((waited + 5))
done
[ "$waited" -ge 300 ] && ynh_print_warn "Dashboard not answering yet after 300s — the node may be mid self-update. Check: docker logs $app"

ynh_script_progression "Freenet upgrade complete."
