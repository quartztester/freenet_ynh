#!/bin/bash
source /usr/share/yunohost/helpers

# Root-only by design: dashboard uses absolute URLs; plain setting so nginx templating (__PATH__) resolves to "/".
path="/"

#=================================================
# NODE BINARY (official GitHub release, static musl)
#=================================================
ynh_script_progression "Installing the Freenet node binary..."
ynh_setup_source --dest_dir="$install_dir"
# The release tarball stores the binary without the exec bit.
chmod 0755 "$install_dir/freenet"
chown -R "$app:$app" "$install_dir"

# The node requires config/ and node/ to exist but generates config.toml itself on first boot.
mkdir -p "$data_dir/config" "$data_dir/node" "$data_dir/home"
chown -R "$app:$app" "$data_dir"

# NB: no config.toml seeding — strictly schema-validated; our keys (ports, allowed Host) are pinned via CLI flags in the systemd unit.

ynh_script_progression "Configuring systemd service..."
ynh_config_add_systemd
ynh_systemctl --service="$app" --action=start --log_path=systemd --timeout=300

#=================================================
# WAIT FOR THE NODE API BEFORE PROXYING IT
#=================================================
ynh_script_progression "Waiting for the node dashboard to come up..."
waited=0
while [ "$waited" -lt 300 ]; do
    if curl -fsS -m 3 "http://127.0.0.1:$port/v1/version" >/dev/null 2>&1; then
        break
    fi
    sleep 5
    waited=$((waited + 5))
done
if [ "$waited" -ge 300 ]; then
    ynh_die --message="Node dashboard did not answer on 127.0.0.1:$port within 300s. Check: journalctl -u $app"
fi

ynh_script_progression "Configuring nginx (SSO-gated node dashboard)..."
ynh_config_add_nginx

# Tile logo for the SSO portal (supported override for non-catalog apps)
if [ -f "$YNH_APP_BASEDIR/doc/freenet.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/freenet.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

version=$("$install_dir/freenet" --version 2>/dev/null | head -1 || true)
ynh_print_warn "Freenet node installed${version:+ ($version)}. Dashboard: https://$domain$path (SSO-gated). Loopback API: http://127.0.0.1:$port"

ynh_script_progression "IMPORTANT: forward UDP $port_peer on your router to this server's LAN address (TCP is not used by the transport), or peers cannot reach you directly and connectivity stays degraded."
