#!/bin/bash
source /usr/share/yunohost/helpers


if [ "${path:-/}" != "/" ]; then
    ynh_die --message="The Freenet dashboard uses absolute URLs and only works at the root of a domain — pick a (sub)domain with path '/'."
fi

peer_port="${peer_port:-31337}"

if ! systemctl is-active --quiet docker; then
    ynh_die --message="The docker service is not running. Install/enable docker first (apt install docker.io docker-compose-v2)."
fi

#=================================================
# FIREWALL (peer transport, UDP)
#=================================================
ynh_script_progression "Opening firewall port $peer_port (UDP)..."
yunohost firewall allow UDP "$peer_port"

#=================================================
# INSTALL FILES
#=================================================
ynh_script_progression "Writing compose config (peer UDP port=$peer_port, dashboard port=$port)..."
ynh_config_add --template="docker-compose.yml" --destination="$install_dir/docker-compose.yml"

ynh_script_progression "Pulling Freenet image (may take a few minutes)..."
# ghcr.io connections can drop mid-layer ("unexpected EOF"); retries resume
# completed layers, so a few attempts converge.
pull_ok=0
for i in 1 2 3 4 5; do
    if docker compose -f "$install_dir/docker-compose.yml" pull; then
        pull_ok=1
        break
    fi
    ynh_print_warn "Image pull attempt $i failed — retrying..."
    sleep 5
done
[ "$pull_ok" -eq 1 ] || ynh_die --message="Could not pull ghcr.io/freenet/freenet-core:latest after 5 attempts. Check connectivity to ghcr.io, then re-run the install."

ynh_script_progression "Configuring systemd service..."
ynh_config_add_systemd
ynh_systemctl --service="$app" --action=start --log_path=systemd --timeout=300

#=================================================
# WAIT FOR THE NODE DASHBOARD TO ANSWER BEFORE
# PROXYING IT (healthcheck = process alive + API up).
#=================================================
ynh_script_progression "Waiting for the node dashboard to come up..."
waited=0
while [ "$waited" -lt 300 ]; do
    if curl -fsS -m 3 "http://127.0.0.1:$port/v1/version" >/dev/null 2>&1; then
        break
    fi
    sleep 5
    waited=$((waited + 5))
done
if [ "$waited" -ge 300 ]; then
    ynh_die --message="Node dashboard did not answer on 127.0.0.1:$port within 300s. Check: docker logs $app"
fi

ynh_script_progression "Configuring nginx (SSO-gated node dashboard)..."
ynh_config_add_nginx

# Tile logo for the SSO portal (supported override for non-catalog apps)
if [ -f "$YNH_APP_BASEDIR/doc/freenet.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/freenet.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

version=$(docker exec "$app" freenet --version 2>/dev/null | head -1 || true)
ynh_print_warn "Freenet node installed${version:+ ($version)}. Dashboard: https://$domain$path (SSO-gated). Loopback API: http://127.0.0.1:$port"

ynh_script_progression "IMPORTANT: forward UDP $peer_port on your router to this server's LAN address (TCP is not used by the transport), or peers cannot reach you directly and connectivity stays degraded."
