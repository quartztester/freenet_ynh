#!/bin/bash
source /usr/share/yunohost/helpers

ynh_abort_if_errors

if [ "$path" != "/" ]; then
    ynh_die --message="The Freenet dashboard UI uses absolute URLs and only works at the root of a domain (path must be '/')."
fi

ynh_script_progression "Moving $app from $old_domain$old_path to $domain$path..."

ynh_safe_rm "/etc/nginx/conf.d/$old_domain.d/$app.conf"
rmdir "/etc/nginx/conf.d/$old_domain.d" 2>/dev/null || true

ynh_app_setting_set --key=domain --value="$domain"
ynh_app_setting_set --key=path --value="$path"

# Re-render compose so FREENET_ALLOWED_HOST picks up the new hostname, then nginx.
ynh_safe_rm "$install_dir/docker-compose.yml"
ynh_config_add --template="docker-compose.yml" --destination="$install_dir/docker-compose.yml"
ynh_config_add_nginx

systemctl daemon-reload
systemctl restart "$app"

ynh_script_progression "Done. Dashboard: https://$domain$path (SSO-gated)."
