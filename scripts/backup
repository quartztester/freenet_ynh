#!/bin/bash
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."
# Node identity, store, config and the (possibly self-updated) binary all
# live under $data_dir/$install_dir — both are archived by convention.
ynh_backup "$data_dir"
ynh_backup "$install_dir/freenet"
ynh_backup "/etc/systemd/system/$app.service"
