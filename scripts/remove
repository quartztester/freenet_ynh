#!/bin/bash
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping Freenet container and removing its data volume..."
if [ -f "$install_dir/docker-compose.yml" ]; then
    docker compose -f "$install_dir/docker-compose.yml" down -v --remove-orphans || true
fi
# Fallbacks in case the compose file was already gone
docker rm -f "$app" 2>/dev/null || true
docker volume rm "$app-data" 2>/dev/null || true

ynh_script_progression "Removing nginx, logo and systemd unit..."
ynh_config_remove_nginx
ynh_config_remove_systemd
systemctl daemon-reload
ynh_safe_rm "/usr/share/yunohost/applogos/$app.png"

peer_port=$(yunohost app setting "$app" peer_port 2>/dev/null || echo "31337")
ynh_script_progression "Closing firewall port $peer_port..."
# NB: 'disallow Both' crashes YH12.1 (moulinette lowercases -> ValueError)
yunohost firewall disallow UDP "$peer_port" || true

ynh_safe_rm "$install_dir/docker-compose.yml"
