[Unit]
Description=Freenet node (app: __APP__)
Documentation=https://freenet.org/quickstart/docker/
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300


### Sandboxing baseline for a docker-CLI wrapper unit.
### NB: no User= here on purpose — this unit only talks to the docker socket,
### which YunoHost admins reach as root/docker-group; running the CLI as the
### unprivileged app user would break container management. The container
### itself drops privileges internally.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectHome=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=~CAP_SYS_BOOT CAP_SYS_MODULE CAP_SYS_PACCT

[Install]
WantedBy=multi-user.target
